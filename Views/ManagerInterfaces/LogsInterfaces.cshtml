@{
    ViewData["Title"] = "Logs Interfaces";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>



<style>





    /* Estilos generales para la página */
    body {
        background-color: #f2f2f7 !important; /* Color de fondo similar a iOS */
        font-family: Arial, sans-serif !important;
    }

    /* Estilos para el panel */
    .panelIOS {
        background-color: #ffffff; /* Color de fondo del panel */
        border-radius: 10px; /* Bordes redondos del panel */
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1); /* Sombra del panel */
        margin: 20px auto; /* Margen exterior del panel */
        padding: 20px; /* Espaciado interno del panel */
        max-width: 90%; /* Ancho máximo del panel */
    }

    /* Estilos para la tabla */
    .tableIOS {
        width: 100%; /* Ancho de la tabla al 100% del panel */
        border-collapse: collapse; /* Colapso de bordes de la tabla */
    }

        .tableIOS th, .tableIOS td {
            padding: 10px; /* Espaciado interno de las celdas de la tabla */
            text-align: center; /* Alineación del texto a la izquierda */
            border-bottom: 1px solid #ccc; /* Borde inferior de las celdas */
            width: 100px;
        }

        /* Estilos para las filas impares de la tabla */
        .tableIOS tr:nth-child(odd) {
            background-color: #f5f5f5; /* Color de fondo para filas impares */
        }

        /* Estilos para las celdas de encabezado de la tabla */
        .tableIOS th {
            background-color: #007AFF; /* Color de fondo del encabezado */
            color: #ffffff; /* Color del texto del encabezado */
        }

        /* Estilos para las celdas de la tabla al pasar el cursor por encima */
        .tableIOS tr:hover {
            background-color: #e0e0e0; /* Color de fondo al pasar el cursor por encima */
        }

    .error-row {
        background-color: red;
        color: white;
    }

    .divContentCompleto {
        display: none;
    }


    /* Estilos para la celda de IsActivo */
    .activoproceso {
        width: 20px; /* Ancho para el círculo */
        height: 20px; /* Altura para el círculo */
        border-radius: 50%; /* Círculo */
        background-color: #ccc; /* Color gris por defecto */
        display: inline-block;
    }

        .activoproceso.verde {
            background-color: #4CAF50; /* Color verde para IsActivo true */
        }
         .activoproceso.rojo {
            background-color: red; /* Color verde para IsActivo true */
        }




  .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7); /* Fondo oscuro */
        }

.modal-content {
    background-color: #ffffff; /* Color de fondo del modal */
    border-radius: 10px; /* Bordes redondos del modal */
    box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5); /* Sombra del modal */
    max-width: 80%;
    margin: 20px auto; /* Margen exterior del modal */
    padding: 20px; /* Espaciado interno del modal */
}

/* Estilos para el botón de cierre del modal */
.close-button {
    float: right;
    cursor: pointer;
}

/* Estilos para la tabla dentro del modal */
.tableDetalleLog {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}

.tableDetalleLog th, .tableDetalleLog td {
    padding: 10px;
    text-align: left;
    border-bottom: 1px solid #ccc;
}









</style>


<script>

    var conecction = new signalR.HubConnectionBuilder()
    .withUrl("/logsinterfaces")
    .build();

    conecction.start().then(function(){

    console.log("Conexcion Exitosa");

    }).catch(function(err)
    {
        console.log(err);

    });

      conecction.on("logresumen",(logsResumen) => {
        
            console.log("Start_logResuemn");
            console.log(logsResumen);

            $("#divContentLogsInterfacesResumen").html("");

            CreaTablaResumenLogLive(logsResumen,"divContentLogsInterfacesResumen");
        
            console.log("End_logResuemn");
    });



    conecction.on("logsinterfaces",(logsInterfaces) => {
        
         console.log("Start_logsinterfaces");
            console.log(logsInterfaces);

        $("#divContentLogsInterfaces").html("");

        CreaTablaResumenLogLive(logsInterfaces,"divContentLogsInterfaces");
        
        console.log("End_logsinterfaces");
    });



        function CreaTablaResumenLogLive(logs,idContent)
        {
            const tableContainer = document.getElementById(idContent);
            const table = document.createElement("table");
            table.classList.add("tableIOS");

            // Crea el encabezado de la tabla
            const thead = document.createElement("thead");
            const headerRow = document.createElement("tr");
            const columnas = Object.keys(logs[0]);

            columnas.forEach(columna => {
                const th = document.createElement("th");
                th.textContent = columna;
                headerRow.appendChild(th);
            });

            thead.appendChild(headerRow);
            table.appendChild(thead);

            // Crea el cuerpo de la tabla con los datos
            const tbody = document.createElement("tbody");

            logs.forEach(log => {
                const row = document.createElement("tr");

                // Agrega las celdas de datos
                columnas.forEach(columna => {
                    const cell = document.createElement("td");
                    const contenido = log[columna];

                    if (columna === "isActivo")
                    {
                        const divActivo = document.createElement("div");
                        
                        divActivo.classList.add("activoproceso", log[columna] ? "verde" : "rojo");

                        cell.appendChild(divActivo);

                    } else {
                        cell.textContent = contenido;
                    }


                    // Aplica estilos a las filas con Error
                    if (columna === "ultimoEstado" && log[columna] =="Error")
                    {
                        row.classList.add("error-row");
                    }

                    row.appendChild(cell);
                });

                var idLog = log["id"];

                row.addEventListener("click", () => {


                    $.ajax({
                        type: 'GET',
                        url: '@Url.Action("GetLogDetalle","ManagerInterfaces")' + "?id="+idLog,
                        success: function (data)
                        {
                            console.log(data);
                            $("#divContentDetalleLog").html(data);
                            $("#divModalLogDetalle").modal('show');
                            
                        },
                        beforeSend: function (e) {
                          $("#divContentDetalleLog").html("");
                        }
                    });

                });

                row.style.cursor = "pointer";

                tbody.appendChild(row);
            });

            table.appendChild(tbody);
            tableContainer.appendChild(table);
        }


        function cerrarModal()
        {
            $("#divModalLogDetalle").modal('hide');
            $("#divContentDetalleLog").html('');
        }

</script>



<h1>Resumen Procesos</h1>
<div class="panelIOS" id="divContentLogsInterfacesResumen">
</div>

<br />

<h2>Logs Live</h2>
<div class="panelIOS" id="divContentLogsInterfaces">
</div>


  <div class="modal fade" id="divModalLogDetalle" data-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content" style="width:90%;">

                <div class="modal-header" style="border:0;">
                    <button class="close"  onclick="cerrarModal()" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                     <div style="width: 100%;" id="divContentDetalleLog"></div>
                </div>
            </div>
        </div>
    </div>