@model List<Drim.Interfaces.MVC.ViewModels.TraspasoProveedorOrigenDestino>



@if (!Model.Any()) 
{

    <p style="color:red;font-style:italic;">Sin Resultados</p>

}else{
   



    <p style="color:green;font-style:italic;">Total Proveedores: @Model.GroupBy(g=> g.codProveedor).Count()</p>
    <br />
<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>Proveedor</th>
            <th>Origen</th>
            <th>Destino</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Total Articulos</th>
            <th>Total Unidades</th>
        </tr>
    </thead>
    <tbody>

            @foreach (var traspasoProveedorDia in Model.OrderBy(x => x.codProveedor))
            {
            <tr data-codproveedor="@traspasoProveedorDia.codProveedor" data-origen="@traspasoProveedorDia.codAlmacenOrigen" data-fechainicio="@traspasoProveedorDia.FechaInicio.ToString("ddMMyyyyHHmmss")" data-fechafin="@traspasoProveedorDia.FechaFin.ToString("ddMMyyyyHHmmss")">
                <td>
                    <a href="#" data-codproveedor="@traspasoProveedorDia.codProveedor"  data-origen="@traspasoProveedorDia.codAlmacenOrigen" data-fechainicio="@traspasoProveedorDia.FechaInicio.ToString("ddMMyyyyHHmmss")" data-fechafin="@traspasoProveedorDia.FechaFin.ToString("ddMMyyyyHHmmss")" style="cursor:pointer;" class="verdetalletraspasosproveedor">+</a>
                </td>

                <td>
                    @(traspasoProveedorDia.codProveedor +"-"+traspasoProveedorDia.NombreProveedor)
                </td>
                <td>
                    @traspasoProveedorDia.NombreAlmacenOrigen
                </td>
                <td>
                    @traspasoProveedorDia.NombreAlmacenDestino
                </td>
                <td>
                    @traspasoProveedorDia.FechaInicio.ToString("dd/MM/yyyy HH:mm:ss")
                </td>
                <td>
                    @traspasoProveedorDia.FechaFin.ToString("dd/MM/yyyy HH:mm:ss")
                </td>
                <td>
                    @traspasoProveedorDia.TotalArticulos
                </td>
                <td>
                    @traspasoProveedorDia.TotalUnidades
                </td>
                <td>
                    <a href="#"   data-codproveedor="@traspasoProveedorDia.codProveedor"  data-origen="@traspasoProveedorDia.codAlmacenOrigen" data-fechainicio="@traspasoProveedorDia.FechaInicio.ToString("ddMMyyyyHHmmss")" data-fechafin="@traspasoProveedorDia.FechaFin.ToString("ddMMyyyyHHmmss")" data-origen="@traspasoProveedorDia.codAlmacenOrigen" data-codarticulo="" style="cursor:pointer;" class="modificarTraspaso">Gestionar</a>
                </td>
            </tr>
            <tr class="@("trdetalleTraspasos_" + traspasoProveedorDia.codProveedor+ "_"+ traspasoProveedorDia.codAlmacenOrigen+ "_" + traspasoProveedorDia.FechaInicio.ToString("ddMMyyyyHHmmss")+ "_" + traspasoProveedorDia.FechaFin.ToString("ddMMyyyyHHmmss"))" style="display:none;width:auto;" data-codproveedor="@traspasoProveedorDia.codProveedor" data-fechainicio="@traspasoProveedorDia.FechaInicio.ToString("ddMMyyyyHHmmss")" data-fechafin="@traspasoProveedorDia.FechaFin.ToString("ddMMyyyyHHmmss")">
                <td></td>
                <td colspan="8" style="padding-left:50px;" class="tdcontentDetalleTraspasosProveedor">
                     @await Html.PartialAsync("~/Views/Shared/Traspasos/TraspasoOrigenDestinoDetalleGrid.cshtml",traspasoProveedorDia.traspasos, new ViewDataDictionary(this.ViewData){ {"IsAlbaranes",true} })
                </td>
            </tr>
        }
    </tbody>
</table>

}
