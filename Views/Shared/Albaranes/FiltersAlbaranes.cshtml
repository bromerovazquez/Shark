 @{
    var AlmacenesList = ViewData["almacenes"] != null?  (List<SelectListItem>)ViewData["almacenes"] : new List<SelectListItem>();
    var index = ViewData["index"] != null?  (int)ViewData["index"] : 0;
    var divContainerGridTraspasos = ViewData["divContainerGridTraspasos"] != null?  (string)ViewData["divContainerGridTraspasos"] : "divContainerGridTraspasos";

    var fechaInicioActual = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 0, 0, 0);
    var fechaFinActual = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day,  23, 59,59);

    var FilterAlmacenOrigenValue = ViewData["FilterAlmacenOrigenValue"] != null ?  (string)ViewData["FilterAlmacenOrigenValue"]:"";
    var FilterAlmacenOrigenOnlyread = ViewData["FilterAlmacenOrigenOnlyread"] != null ?  (bool)ViewData["FilterAlmacenOrigenOnlyread"]:false;

    var FilterAlmacenDestinoValue = ViewData["FilterAlmacenDestinoValue"] != null ?  (string)ViewData["FilterAlmacenDestinoValue"]:"";
    var FilterAlmacenDestinoOnlyread = ViewData["FilterAlmacenDestinoOnlyread"] != null ?  (bool)ViewData["FilterAlmacenDestinoOnlyread"]:false;

   

}







<div id="divContentFilter@index">

    <input type="hidden" id="hidContainerGridResult" value="@divContainerGridTraspasos" />

<div class="row form-group mt-3">
    
    @await Html.PartialAsync("~/Views/Shared/Comun/FiltroAlmacen.cshtml",AlmacenesList, new  ViewDataDictionary(this.ViewData){  { "LabelAlmacen","Almacen Origen"  },{"IdAlmacen","ddlFilterAlmacenOrigen"},{"colLabel","col-3"},{"colSelect","col-3"},{"value",FilterAlmacenOrigenValue},{"onlyread",FilterAlmacenOrigenOnlyread}})

    @await Html.PartialAsync("~/Views/Shared/Comun/FiltroAlmacen.cshtml",AlmacenesList, new  ViewDataDictionary(this.ViewData){  { "LabelAlmacen","Almacen Destino"  },{"IdAlmacen","ddlFilterAlmacenDestino"},{"colLabel","col-3"},{"colSelect","col-3"},{"value",FilterAlmacenDestinoValue},{"onlyread",FilterAlmacenDestinoOnlyread},{"isDevolucion",true}})
</div>

<div class="row form-group mt-3">
    @await Html.PartialAsync("~/Views/Shared/Comun/FiltroProveedor.cshtml", new  ViewDataDictionary(this.ViewData){ {"colLabel","col-3"},{"colSelect","col-3"}})
</div>

<div class="row form-group mt-3">
    @await Html.PartialAsync("~/Views/Shared/Comun/FiltroRangoFechas.cshtml", new  ViewDataDictionary(this.ViewData){ {"colLabel","col-3"},{"colSelect","col-3"},{"ValueFechaInicio",fechaInicioActual},{"ValueFechaFin",fechaFinActual}})
</div>
<div class="row form-group mt-3">
    @await Html.PartialAsync("~/Views/Shared/Comun/FiltroArticulo.cshtml", new  ViewDataDictionary(this.ViewData){ {"colLabel","col-3"},{"colSelect","col-3"}})
<label class="col-3 col-form-label drim-label">Estado:</label>
    <div class="col-3">
    <select id="ddlFilterEstadoAlbaranes" class="form-control">
        <option value="">--Todo--</option>
        <option value="Sin Gestionar">Sin Gestionar</option>
        <option value="Albaran Generado">Albaran Generado</option>
        <option value="En Cola">En Cola</option>
    </select>
    </div>
</div>

<div class="row form-group mt-3">
    <div class="col-3">
        <input  class="btn btn-primary"  type="button" value="Buscar Traspaso" id="tbnBuscarAlbaranes"  />
    </div>

    <div class="col-3">
        <input  class="btn btn-danger btngeneraalbaranes"  type="button" value="Generar Albaran por Proveedor" data-isseparadoportienda="false" id="tbnGenerarAlbaranUnico"  />
    </div>
    <div class="col-3">
        <input  class="btn btn-danger btngeneraalbaranes"  type="button" value="Generar Albaran por Proveedor Tienda" data-isseparadoportienda="true" id="tbnGenerarAlbaranPorTienda"  />
    </div>
</div>

</div>