        var GetModeloDataByContentTable = function(content)
        {
                var filas = content.find('tbody').first().find('tr');

                var resultados = [];

                for (var i = 0; i < filas.length; i++)
                {

                var fila = filas[i];


                var inputs = fila.getElementsByTagName("input");
                var selects = fila.getElementsByTagName("select");
                var objeto = {};

                for (var j = 0; j < inputs.length; j++) {
                    var nombre = inputs[j].getAttribute("name");
                    var type = inputs[j].getAttribute("type");
                    var valor = type == "checkbox"?inputs[j].checked? "true":"false": nombre=="ValueParametro"? inputs[j].getAttribute('data-value') : inputs[j].value;
                    objeto[nombre] = valor;
                }

                for (var k = 0; k < selects.length; k++) {
                    var nombre = selects[k].getAttribute("name");
                    var valor = selects[k].value;
                    objeto[nombre] = valor;
                }

                resultados.push(objeto);
                }

            return resultados;
        }


