    });



</script>




<ul id="ulPestayasPrincipal" class="nav nav-tabs">
    @foreach (var item in Model.Where(x => x.IsMenuPestayas.HasValue && x.IsMenuPestayas.Value).OrderBy(x => x.OrderDisplay))
    {
        <li class="nav-item">
            <a id="@("pestañaprincipal"+item.IdPagina)" data-modulo="@item.Pagina" data-url="@Url.Action(item.Action, item.Controller)"  class="@("nav-link alinkprincipal itemmenupestañas " + (@item.IdPagina == 3? "active":"")) OKSavedModule" data-idpanel="@("tabprincipal"+item.IdPagina)">@item.DisplayText</a>
        </li>
    }
</ul>



