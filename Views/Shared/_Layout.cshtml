            }




        });


         var focusSelect = "";


        $(document).ready(function(e)
        {


             $('.selectpicker').on('show.bs.select', function (e, clickedIndex, isSelected, previousValue) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        console.log("selectpicker.show.bs.select");
                        focusSelect =  $(this).prop('id');
                        console.log(focusSelect);
                    });


            $('body').delegate('.bs-searchbox input', "keyup", function (e) {
                        console.log('bs-searchbox');

                        var keyword = $(this).val();
                        var isSearchServer = $("#"+ focusSelect).data("issearchserver");

                        console.log(keyword);

                        if (e.keyCode == "13" || e.keyCode == "9")
                        {
                            if (focusSelect.toString().toLowerCase().indexOf("articulo") != -1)
                            {
                                SearchArticuloKeyWord(keyword,focusSelect);
                            }

                        }
                        if(keyword.length>3){
                        if(focusSelect.toString().toLowerCase().indexOf("Proveedor") != -1)
                            {
                                SearchProveedorKeyWord(keyword,focusSelect);
                            }
                        }

                    });

        });

                var FormatDateTime = function (datetimeStr) {

                    if ((datetimeStr != 'undefined' || datetimeStr !== undefined)) {
                        var datetimeStrSplit = [];

                        if (datetimeStr.indexOf('-') != -1) {
                            datetimeStrSplit = datetimeStr.split('-');
                            datetimeStr = PadLeft(datetimeStrSplit[2], 2) + "/" + PadLeft(datetimeStrSplit[1], 2) + "/" + datetimeStrSplit[0];
                        } else if (datetimeStr.indexOf('/') != -1) {
                            datetimeStrSplit = datetimeStr.split('/');
                            datetimeStr = PadLeft(datetimeStrSplit[0], 2) + "/" + PadLeft(datetimeStrSplit[1], 2) + "/" + datetimeStrSplit[2];

                        }
                    }

                    return datetimeStr;
                };

                function PadLeft(value, length) {
                    return (value.toString().length < length) ? PadLeft("0" + value, length) : value;
                }



                var ObtenerDiasDiff = function (fechaInicio, fechaFin) {


                    var date_1 = new Date(fechaInicio);
                    var date_2 = new Date(fechaFin);

                    var day_as_milliseconds = 86400000;
                    var diff_in_millisenconds = date_2 - date_1;
                    var diff_in_days = diff_in_millisenconds / day_as_milliseconds;

                    //console.log(diff_in_days);

                    return diff_in_days + 1;
                };



                 var SearchArticuloKeyWord = function (keyword, IdSelect) {

                    console.log("SearchArticuloKeyWord");

                    $.ajax({

                        type: 'GET',
                         url: '@(Url.Action("SearchArticuloKeyWord","Base") + "?keyword=")' + keyword,
                        success: function (data) {

                            data = JSON.parse(data.result);
                            console.log(data);


                            var options = "<option value='clear'>--- Deseleccionar x ---</option>";

                            for (var i = 0; i < data.length; i++) {

                                options += "<option value='" + data[i].Value + "'>" + data[i].Text + "</option>";
                            }

                            $("#" + IdSelect).append(options);
                            $("#" + IdSelect).selectpicker('refresh');

                        },
                        beforeSend: function (e) {

                            $("#" + IdSelect).html("");
                            $("#" + IdSelect).selectpicker('refresh');
                        }
                    });
                };

                 var SearchProveedorKeyWord = function (keyword, IdSelect) {

                    console.log("SearchProveedorKeyWord");

                    $.ajax({

                        type: 'GET',
                         url: '@(Url.Action("SearchProveedorKeyWord","Base") + "?keyword=")' + keyword,
                        success: function (data) {

