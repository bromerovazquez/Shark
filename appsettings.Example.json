{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "LogsFiles/log.txt",
          "outputTemplate": "{Timestamp:G} {Message}{NewLine:1}{Exception:1}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "SegundosCheckProcessInterfaces": 10000,
  "SegundosCheckProcessLogInterfaces": 5000,
  "Entorno": "dev",
  "EmailsTEST": "<correo-pruebas>",
  "EmailsRRHHTEST": "<correo-pruebas>",
  "Database": {
    "ConnectionTemplate": "Password={0};Persist Security Info=True;User ID={1};Initial Catalog={2};Data Source={3};",
    "ProductionServer": "<servidor-produccion>",
    "DevelopmentServer": "<servidor-desarrollo>",
    "ProductionUser": "<usuario-produccion>",
    "ProductionPassword": "<contraseña-produccion>",
    "DevelopmentUser": "<usuario-desarrollo>",
    "DevelopmentPassword": "<contraseña-desarrollo>",
    "A3LaboralServer": "<servidor-a3laboral>",
    "AppDrimServer": "<servidor-appdrim>",
    "A3CommonServer": "<servidor-a3common>",
    "ElMundoDeDrim": {
      "Server": "<servidor>",
      "Database": "<base-datos>",
      "User": "<usuario>",
      "Password": "<contraseña>"
    }
  },
  "ExternalServices": {
    "DataExchangeEndpoint": "<url-soap>",
    "HttpBaseAddress": "<url-http>",
    "Smtp": {
      "Host": "<servidor-smtp>",
      "Port": 587,
      "EnableSsl": false
    }
  },
  "EmailAccounts": {
    "ControlHorario": { "Address": "<correo>", "Password": "<contraseña>" },
    "RecursosHumanos": { "Address": "<correo>", "Password": "<contraseña>" },
    "Seleccion": { "Address": "<correo>", "Password": "<contraseña>" },
    "Contratacion": { "Address": "<correo>", "Password": "<contraseña>" },
    "Informes": { "Address": "<correo>", "Password": "<contraseña>" }
  },
  "ftphost_Adaia": "<host-ftp>",
  "ftpUser_Adaia": "<usuario-ftp>",
  "ftpPass_Adaia": "<contraseña-ftp>",
  "ftpDirectorio_de_Gestion": "<directorio>",
  "ftpDirectorio_a_Gestion": "<directorio>",
  "LocalDirectorio_de_Adaia": "<ruta-local>",
  "LocalDirectorio_a_Adaia": "<ruta-local>",
  "Path": {
    "Local": "<ruta-local>",
    "Repositorio": "<ruta-unc>",
    "PathRootVirtual": "<url-publica>"
  },
  "PathDev": {
    "Local": "<ruta-local>",
    "Repositorio": "<ruta-unc>",
    "PathRootVirtual": "<url-desarrollo>"
  },
  "Path_Origen_Manager": { "url": "<ruta-unc>", "usuario": "", "pass": "" },
  "Path_Destino_Adaia": { "url": "<ftp>", "usuario": "<usuario>", "pass": "<contraseña>" },
  "Path_Origen_Adaia": { "url": "<ftp>", "usuario": "<usuario>", "pass": "<contraseña>" },
  "Path_Destino_Manager": { "url": "<ruta-unc>", "usuario": "", "pass": "" }
}
